{
  "name": "bartendergpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/domain",
    "packages/db",
    "apps/api",
    "apps/chatgpt"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "db:init": "npm run db:init --workspace @bartendergpt/db",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:chatgpt": "tsx watch apps/chatgpt/src/index.ts",
    "start:api": "node apps/api/dist/index.js",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}

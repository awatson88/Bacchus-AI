generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductCategory {
  WINE
  SPIRIT
  LIQUEUR
  APERITIF
  BITTERS
  SYRUP
  MIXER
}

enum InventoryStatus {
  SEALED
  OPEN
  LOW
  EMPTY
  CONSUMED
  MISSING
}

enum InventorySourceSystem {
  MANUAL
  IMAGE_INTAKE
  CELLARTRACKER_IMPORT
}

enum InventoryEventType {
  ACQUIRED
  OPENED
  POURED
  CONSUMED
  MOVED
  CORRECTED
  DELETED
}

enum LocationType {
  CELLAR
  KITCHEN
  BAR_CART
  CABINET
  FRIDGE
}

enum AssetType {
  FRONT_LABEL
  BACK_LABEL
  SHELF_PHOTO
  RECEIPT
}

model Product {
  id             String          @id @default(cuid())
  category       ProductCategory
  producer       String
  name           String
  country        String?
  region         String?
  subregion      String?
  style          String?
  grapeVarieties String[]
  baseSpirit     String?
  defaultAbv     Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  variants       Variant[]

  @@index([category, producer, name])
}

model Variant {
  id                String             @id @default(cuid())
  productId         String
  vintage           Int?
  bottlingName      String?
  sizeMl            Int?
  abv               Float?
  packaging         String?
  upcOrBarcode      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItems    InventoryItem[]
  enrichmentRecords EnrichmentRecord[]

  @@index([productId, vintage])
}

model Location {
  id                 String          @id @default(cuid())
  name               String
  type               LocationType
  temperatureProfile String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  inventoryItems     InventoryItem[]

  @@unique([name, type])
}

model InventoryItem {
  id                String                @id @default(cuid())
  variantId         String
  locationId        String?
  bin               String?
  status            InventoryStatus       @default(SEALED)
  fillPercent       Int?
  acquiredAt        DateTime?
  purchaseSource    String?
  purchasePrice     Decimal?              @db.Decimal(10, 2)
  drinkFrom         DateTime?
  drinkTo           DateTime?
  drinkWindowSource String?
  qualityScore      Float?
  confidence        Float?
  sourceSystem      InventorySourceSystem @default(MANUAL)
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  location          Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  variant           Variant               @relation(fields: [variantId], references: [id], onDelete: Cascade)
  events            InventoryEvent[]
  mediaAssets       MediaAsset[]

  @@index([variantId, status])
  @@index([locationId, status])
  @@index([locationId, bin])
}

model InventoryEvent {
  id              String             @id @default(cuid())
  inventoryItemId String
  eventType       InventoryEventType
  quantityDelta   Decimal?           @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime           @default(now())
  inventoryItem   InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, createdAt])
}

model MediaAsset {
  id              String        @id @default(cuid())
  inventoryItemId String
  storageKey      String
  assetType       AssetType
  createdAt       DateTime      @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, assetType])
}

model EnrichmentRecord {
  id            String   @id @default(cuid())
  variantId     String
  provider      String
  providerUrl   String?
  rawPayload    Json
  matchedFields Json?
  confidence    Float?
  lastCheckedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  variant       Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, provider])
}

model PantryProfile {
  id                String   @id @default(cuid())
  name              String   @default("default")
  assumeLime        Boolean  @default(true)
  assumeLemon       Boolean  @default(true)
  assumeSimpleSyrup Boolean  @default(true)
  assumeSoda        Boolean  @default(true)
  assumeIce         Boolean  @default(true)
  trackedOddballs   String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([name])
}

model Recipe {
  id         String   @id @default(cuid())
  name       String
  ingredients Json
  technique  String?
  tags       String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([name])
}
